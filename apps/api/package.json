{
  "name": "@wedding/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@wedding/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
