# ─────────────────────────────────────────────────────────────
#  Digital Wedding Invitation — environment configuration
#  Copy to `.env` and edit. Never commit your `.env`.
#  All invitation CONTENT (names, events, gifts, music, …) is edited
#  in the admin dashboard at /admin — not here.
# ─────────────────────────────────────────────────────────────

# Public URL guests will open (used to build personal invite links).
PUBLIC_URL=http://localhost:8080

# Host interface and port the web container publishes.
# Use 127.0.0.1 when another reverse proxy / tunnel runs on the same host.
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=8080

# ── Admin login ──────────────────────────────────────────────
ADMIN_USERNAME=admin
# Option A: plaintext password, hashed with argon2id on first boot and then
# stored only as a hash. Remove it from this file after first start.
ADMIN_PASSWORD=change-me-please-123
# Option B (preferred): a pre-computed argon2id hash. Generate with:
#   docker compose run --rm -T api node dist/scripts/hash-password.js
# Wrap it in SINGLE quotes because it contains `$` characters.
ADMIN_PASSWORD_HASH=

# Random secret (>= 32 chars) used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=168

# Cookies are sent only over HTTPS when true. Set to false ONLY for plain-HTTP
# local testing (e.g. http://localhost:8080). Keep true behind TLS.
COOKIE_SECURE=true

# How many reverse-proxy hops to trust for client IPs (rate limiting).
# 1 = the bundled nginx only. Use 2 if you put Cloudflare/Traefik/NPM in front.
TRUST_PROXY=1

# ── Limits ───────────────────────────────────────────────────
MAX_UPLOAD_MB=15
RATE_LIMIT_PUBLIC_PER_MIN=20
RATE_LIMIT_LOGIN_PER_15MIN=10

# ── Misc ─────────────────────────────────────────────────────
TZ=Asia/Jakarta
LOG_LEVEL=info
IMAGE_TAG=latest
